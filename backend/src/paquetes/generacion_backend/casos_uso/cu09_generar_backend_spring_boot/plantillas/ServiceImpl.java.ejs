package <%= proyecto.packageName %>.servicio.impl;

import <%= proyecto.packageName %>.modelo.<%= entidad.nombreClase %>;
<% if (entidad.esAsociativa) { %>import <%= proyecto.packageName %>.modelo.<%= entidad.tipoId %>;
<% } %>
import <%= proyecto.packageName %>.repositorio.<%= entidad.nombreClase %>Repository;
import <%= proyecto.packageName %>.servicio.<%= entidad.nombreClase %>Service;
import java.util.List;
import org.springframework.stereotype.Service;

@Service
public class <%= entidad.nombreClase %>ServiceImpl implements <%= entidad.nombreClase %>Service {

    private final <%= entidad.nombreClase %>Repository repositorio;

    public <%= entidad.nombreClase %>ServiceImpl(<%= entidad.nombreClase %>Repository repositorio) {
        this.repositorio = repositorio;
    }

    @Override
    public List<<%= entidad.nombreClase %>> listar() {
        return repositorio.findAll();
    }

    @Override
    public <%= entidad.nombreClase %> obtenerPorId(<%= entidad.tipoId %> id) {
        return repositorio.findById(id)
            .orElseThrow(() -> new IllegalArgumentException("<%= entidad.nombreClase %> no encontrado: " + id));
    }

    @Override
    public <%= entidad.nombreClase %> crear(<%= entidad.nombreClase %> <%= entidad.nombreVariable %>) {
<% if (!entidad.esAsociativa) { %>        <%= entidad.nombreVariable %>.setId(null);
<% } %>
        return repositorio.save(<%= entidad.nombreVariable %>);
    }

    @Override
    public <%= entidad.nombreClase %> actualizar(<%= entidad.tipoId %> id, <%= entidad.nombreClase %> <%= entidad.nombreVariable %>) {
        <%= entidad.nombreClase %> existente = obtenerPorId(id);
<% for (const campo of entidad.campos) { %>        existente.set<%= campo.nombreCampo.charAt(0).toUpperCase() + campo.nombreCampo.slice(1) %>(<%= entidad.nombreVariable %>.get<%= campo.nombreCampo.charAt(0).toUpperCase() + campo.nombreCampo.slice(1) %>());
<% } %><% for (const relacion of entidad.relacionesMuchosAUno) { %>        existente.set<%= relacion.nombreCampo.charAt(0).toUpperCase() + relacion.nombreCampo.slice(1) %>(<%= entidad.nombreVariable %>.get<%= relacion.nombreCampo.charAt(0).toUpperCase() + relacion.nombreCampo.slice(1) %>());
<% } %>        return repositorio.save(existente);
    }

    @Override
    public void eliminar(<%= entidad.tipoId %> id) {
        repositorio.delete(obtenerPorId(id));
    }
}
