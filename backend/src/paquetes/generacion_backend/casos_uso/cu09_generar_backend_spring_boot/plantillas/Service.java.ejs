package <%= proyecto.packageName %>.servicio;

import <%= proyecto.packageName %>.modelo.<%= entidad.nombreClase %>;
<% if (entidad.esAsociativa) { %>import <%= proyecto.packageName %>.modelo.<%= entidad.tipoId %>;
<% } %>
import java.util.List;

public interface <%= entidad.nombreClase %>Service {

    List<<%= entidad.nombreClase %>> listar();

    <%= entidad.nombreClase %> obtenerPorId(<%= entidad.tipoId %> id);

    <%= entidad.nombreClase %> crear(<%= entidad.nombreClase %> <%= entidad.nombreVariable %>);

    <%= entidad.nombreClase %> actualizar(<%= entidad.tipoId %> id, <%= entidad.nombreClase %> <%= entidad.nombreVariable %>);

    void eliminar(<%= entidad.tipoId %> id);
}
