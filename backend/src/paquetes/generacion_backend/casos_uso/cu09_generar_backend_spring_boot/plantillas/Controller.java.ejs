package <%= proyecto.packageName %>.controlador;

import <%= proyecto.packageName %>.modelo.<%= entidad.nombreClase %>;
<% if (entidad.esAsociativa) { %>import <%= proyecto.packageName %>.modelo.<%= entidad.tipoId %>;
<% } %>
import <%= proyecto.packageName %>.servicio.<%= entidad.nombreClase %>Service;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/<%= entidad.nombreVariable %>")
public class <%= entidad.nombreClase %>Controller {

    private final <%= entidad.nombreClase %>Service servicio;

    public <%= entidad.nombreClase %>Controller(<%= entidad.nombreClase %>Service servicio) {
        this.servicio = servicio;
    }

    @GetMapping
    public List<<%= entidad.nombreClase %>> listar() {
        return servicio.listar();
    }

<% if (entidad.esAsociativa) { %>    @GetMapping("/<%= entidad.claveCompuesta.campos.map(campo => `{${campo.nombreCampo}}`).join("/") %>")
    public <%= entidad.nombreClase %> obtenerPorId(<% entidad.claveCompuesta.campos.forEach((campo, indice) => { %>@PathVariable Long <%= campo.nombreCampo %><%= indice < entidad.claveCompuesta.campos.length - 1 ? ", " : "" %><% }) %>) {
        <%= entidad.tipoId %> id = new <%= entidad.tipoId %>();
<% for (const campo of entidad.claveCompuesta.campos) { %>        id.set<%= campo.nombreCampo.charAt(0).toUpperCase() + campo.nombreCampo.slice(1) %>(<%= campo.nombreCampo %>);
<% } %>        return servicio.obtenerPorId(id);
    }
<% } else { %>    @GetMapping("/{id}")
    public <%= entidad.nombreClase %> obtenerPorId(@PathVariable Long id) {
        return servicio.obtenerPorId(id);
    }
<% } %>

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    public <%= entidad.nombreClase %> crear(@RequestBody <%= entidad.nombreClase %> <%= entidad.nombreVariable %>) {
        return servicio.crear(<%= entidad.nombreVariable %>);
    }

<% if (entidad.esAsociativa) { %>    @PutMapping("/<%= entidad.claveCompuesta.campos.map(campo => `{${campo.nombreCampo}}`).join("/") %>")
    public <%= entidad.nombreClase %> actualizar(
        <% entidad.claveCompuesta.campos.forEach((campo, indice) => { %>@PathVariable Long <%= campo.nombreCampo %>,
        <% }) %>@RequestBody <%= entidad.nombreClase %> <%= entidad.nombreVariable %>
    ) {
        <%= entidad.tipoId %> id = new <%= entidad.tipoId %>();
<% for (const campo of entidad.claveCompuesta.campos) { %>        id.set<%= campo.nombreCampo.charAt(0).toUpperCase() + campo.nombreCampo.slice(1) %>(<%= campo.nombreCampo %>);
<% } %>        return servicio.actualizar(id, <%= entidad.nombreVariable %>);
    }
<% } else { %>    @PutMapping("/{id}")
    public <%= entidad.nombreClase %> actualizar(
        @PathVariable Long id,
        @RequestBody <%= entidad.nombreClase %> <%= entidad.nombreVariable %>
    ) {
        return servicio.actualizar(id, <%= entidad.nombreVariable %>);
    }
<% } %>

<% if (entidad.esAsociativa) { %>    @DeleteMapping("/<%= entidad.claveCompuesta.campos.map(campo => `{${campo.nombreCampo}}`).join("/") %>")
    @ResponseStatus(HttpStatus.NO_CONTENT)
    public void eliminar(<% entidad.claveCompuesta.campos.forEach((campo, indice) => { %>@PathVariable Long <%= campo.nombreCampo %><%= indice < entidad.claveCompuesta.campos.length - 1 ? ", " : "" %><% }) %>) {
        <%= entidad.tipoId %> id = new <%= entidad.tipoId %>();
<% for (const campo of entidad.claveCompuesta.campos) { %>        id.set<%= campo.nombreCampo.charAt(0).toUpperCase() + campo.nombreCampo.slice(1) %>(<%= campo.nombreCampo %>);
<% } %>        servicio.eliminar(id);
    }
<% } else { %>    @DeleteMapping("/{id}")
    @ResponseStatus(HttpStatus.NO_CONTENT)
    public void eliminar(@PathVariable Long id) {
        servicio.eliminar(id);
    }
<% } %>
}
