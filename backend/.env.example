# Servidor CASE
PORT=3001

# Groq — clave compartida por texto, voz y visión (secreto; completar localmente)
GROQ_API_KEY=

# Groq — IA por texto
GROQ_MODEL=openai/gpt-oss-20b

# Groq — transcripción por voz
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_LANGUAGE=es

# Groq — visión
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Persistencia de proyectos (opcional; por defecto: backend/.sw1-data/proyectos)
# SW1_PROJECTS_DIR=ruta/portable/a/proyectos

# Interoperabilidad XMI (opcionales; se usan los repositorios/ejecutables locales por defecto)
# SW1_CRUNCH_UML_PATH=ruta/portable/a/crunch_uml
# SW1_PYTHON_PATH=ruta/portable/al/ejecutable/python
# translators_default_region=EN

# Pruebas manuales de aceptación Groq (opcionales; no se requieren para npm run dev)
# SW1_VOICE_FIXTURE=ruta/portable/a/audio.wav
# SW1_IMAGE_FIXTURE=ruta/portable/a/diagrama.png

# Prueba manual PostgreSQL (opcional; SW1_PG_PASSWORD es secreto)
# SW1_PG_HOST=127.0.0.1
# SW1_PG_PORT=5432
# SW1_PG_USER=postgres
# SW1_PG_PASSWORD=
# SW1_PG_ADMIN_DB=postgres
# SW1_PG_TEST_DB=sw1_iteracion07
