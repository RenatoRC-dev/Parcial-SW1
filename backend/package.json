{
  "name": "sw1-case-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/paquetes/generacion_backend/api/iniciarServidorGeneracionBackend.ts",
    "start": "node dist/paquetes/generacion_backend/api/iniciarServidorGeneracionBackend.js",
    "dev:e2e": "node scripts/prepararDatosE2E.mjs && tsx watch src/paquetes/generacion_backend/api/iniciarServidorGeneracionBackend.ts --proveedor-ia-determinista --datos-proyectos-e2e",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "prebuild": "node scripts/limpiarDist.mjs",
    "build": "tsc --pretty false && node scripts/copiarPlantillas.mjs",
    "generate:fixture": "tsx src/paquetes/generacion_backend/casos_uso/cu09_generar_backend_spring_boot/generarFixtureCliente.ts",
    "proof:http": "tsx src/paquetes/generacion_backend/api/probarFlujoHttp.ts",
    "proof:relation": "tsx src/paquetes/generacion_backend/api/probarFlujoRelacionHttp.ts",
    "proof:postgres": "tsx src/paquetes/generacion_backend/pruebas_runtime/probarFlujoPostgreSQL.ts",
    "proof:flutter-sync:postgres": "tsx src/paquetes/generacion_backend/pruebas_runtime/probarSincronizacionFlutterPostgreSQL.ts",
    "proof:xmi": "tsx src/paquetes/interoperabilidad/pruebas_runtime/probarFlujoXmi.ts",
    "proof:ia:groq": "tsx src/paquetes/asistencia_ia/pruebas/probarGroqReal.ts",
    "proof:voz:groq": "tsx src/paquetes/asistencia_ia/pruebas/probarVozGroqReal.ts",
    "proof:imagen:groq": "tsx src/paquetes/asistencia_ia/pruebas/probarVisionGroqReal.ts",
    "proof:contexto:groq": "tsx src/paquetes/asistencia_contextual/pruebas/probarContextoGroqReal.ts",
    "proof:proyectos": "tsx src/paquetes/gestion_proyectos/pruebas_runtime/probarPersistenciaProyectos.ts"
  },
  "dependencies": {
    "ejs": "3.1.10",
    "express": "5.2.1",
    "groq-sdk": "^1.6.0",
    "jszip": "3.10.2",
    "multer": "^2.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "24.3.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "7.2.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
